      <Placemark>
        <name>Kiyomizu-dera</name>
        <description>Visita turística el 12. El 14 se anuncia aquí el Kanji del Año, pero la zona de la caligrafía está restringida y no se puede presenciar el acto.</description>
        <styleUrl>#eventStyle</styleUrl>
        <Point>
          <coordinates>135.78448,34.99442,0</coordinates>
        </Point>
