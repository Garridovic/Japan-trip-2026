      <IconStyle>
        <color>ff703d27</color>
        <scale>1.05</scale>
        <Icon>
          <href>https://maps.google.com/mapfiles/kml/pushpin/wht-pushpin.png</href>
        </Icon>
      </IconStyle>
    </Style>
