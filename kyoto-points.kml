        </Point>
      </Placemark>
      <Placemark>
        <name>Kyoto City Tōbu Culture Hall</name>
        <description>Sede de las representaciones del festival. Dirección oficial: 1-8 Nishiura-cho, Nagitsuji, Yamashina-ku. Pin aproximado; abre el enlace para confirmar.</description>
        <styleUrl>#eventStyle</styleUrl>
        <Point>
          <coordinates>135.8139,34.9725,0</coordinates>
        </Point>
      </Placemark>
