<?xml version='1.0' encoding='utf-8'?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <name>Kioto · Itinerario y puntos de interés · 11–15 diciembre 2026</name>
    <description>Exportación opcional del mapa de la guía web. La web de GitHub Pages es la forma recomendada de consultar y navegar los puntos durante el viaje.</description>
